VITE_AUTH_MODE=firebase_optional

# Firebase Web app config. These values are public client config, not Admin SDK secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-side Firebase token verification.
# Keep this optional during migration. Do not commit Firebase Admin/service-account secrets.
SERVER_AUTH_MODE=legacy
FIREBASE_PROJECT_ID=
